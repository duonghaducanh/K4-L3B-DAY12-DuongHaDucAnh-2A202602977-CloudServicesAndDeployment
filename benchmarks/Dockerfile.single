# Original single-stage layout, retained only for the exercise 3 measurement.
# Build with the SAME safe .dockerignore as the production image.
FROM python:3.11
WORKDIR /app
COPY . .
RUN pip install -r requirements.txt
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
